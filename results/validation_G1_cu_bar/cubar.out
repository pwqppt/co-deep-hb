  INITIAL DIRECTORY = C:\Users\USER\.claude-science\orgs\f50c262b-2754-4e2c-b4cd-c0deca628d34\workspaces\0b7dce47-624a-4a52-8bdc-8d464908c370\batch_run

 RELEASE= 2026 R1              BUILD= 26.1      UP20260202   VERSION=WINDOWS x64 
 CURRENT JOBNAME=cubar  19:21:37  OCT 08, 2026  Elapsed Time=       0.078

     1  ! ===================================================================== 
     2  !  Cu bar 1-D thermal expansion benchmark -- uMKS consistent units  
     3  !  length um | mass kg | time s | temp degC  =>  force uN, stress MPa   
     4  !   
     5  !  Load step 1 : free axial expansion      -> UX(node 2) = a*dT*L0  
     6  !  Load step 2 : both ends axially fixed   -> Sxx        = -E*a*dT  
     7  !   
     8  !  Analytic (a=16.5e-6/degC, dT=375 degC, L0=1000 um, E=110000 MPa):
     9  !      UX  =    6.187500 um 
    10  !      Sxx = -680.625000 MPa
    11  !   
    12  !  No /BATCH and no /EXIT here on purpose: the deck is shared by the
    13  !  PyMAPDL path (mapdl.input) and the batch path (runner appends /EXIT).
    14  ! ===================================================================== 
    15  /TITLE,Cu bar thermal expansion 25C -> 400C (uMKS)  
    16      
    17  /PREP7  
    18  ET,1,LINK180
    19  SECTYPE,1,LINK  
    20  SECDATA,1.0                ! cross-section area A = 1 um^2  
    21      
    22  MP,EX,1,110000             ! E   = 110 GPa = 110000 MPa 
    23  MP,PRXY,1,0.34  
    24  MP,ALPX,1,16.5e-6          ! secant CTE, 1/degC 
    25  MP,REFT,1,25               ! material reference temperature, degC   
    26      
    27  N,1,0,0,0   
    28  N,2,1000,0,0               ! L0 = 1000 um   
    29  TYPE,1  
    30  SECN,1  
    31  MAT,1   
    32  E,1,2   
    33  FINISH  
    34      
    35  /SOLU   
    36  ANTYPE,STATIC   
    37  TREF,25 
    38      
    39  ! ---- LS1: statically determinate (free to grow along X) ----  
    40  D,1,UX,0
    41  D,1,UY,0
    42  D,1,UZ,0
    43  D,2,UY,0
    44  D,2,UZ,0
    45  BF,1,TEMP,400   
    46  BF,2,TEMP,400   
    47  SOLVE   
    48      
    49  ! ---- LS2: fully constrained -> pure thermal stress ----   
    50  D,2,UX,0
    51  SOLVE   
    52  FINISH  
    53      
    54  /POST1  
    55  SET,1,1 
    56  *GET,UX2,NODE,2,U,X        ! free expansion, um 
    57  SET,2,1 
    58  ETABLE,SAXL,LS,1
    59  *GET,SIG,ELEM,1,ETAB,SAXL  ! constrained axial stress, MPa  
    60      
    61  *CFOPEN,results,txt 
    62  *VWRITE,UX2,SIG 
    63  ('RESULT ',E20.12,' ',E20.12)   
    64  *CFCLOS 
    65  FINISH  
    66      
    67  /EXIT,NOSAVE

